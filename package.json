{
  "name": "design-system",
  "private": true,
  "version": "0.0.0",
  "description": "Sette Design System monorepo: Figma Variables \u2192 tokens \u2192 Tailwind \u2192 React components.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "tokens:build": "pnpm --filter @design-system/tokens build",
    "build": "pnpm build:packages && pnpm --filter @design-system/playground build",
    "dev": "pnpm tokens:build && pnpm --filter @design-system/storybook dev",
    "build-storybook": "pnpm tokens:build && pnpm --filter @design-system/storybook build",
    "prelint": "pnpm build:packages",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "a11y": "pnpm build && pnpm build-storybook && pnpm --filter @design-system/a11y sweep",
    "figma:sync": "pnpm --filter @design-system/figma-sync sync",
    "clean": "pnpm -r exec rm -rf dist .turbo coverage",
    "pretypecheck": "pnpm build:packages",
    "pretest": "pnpm build:packages",
    "build:packages": "pnpm -r --workspace-concurrency=1 --filter './packages/*' build",
    "playground": "pnpm build:packages && pnpm --filter @design-system/playground dev",
    "a11y:unit": "pnpm -r test:a11y",
    "figma:check": "pnpm --filter @design-system/figma-sync check",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build:packages && changeset publish",
    "check:package": "pnpm --filter @sette/ui check:package"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}

{
  "name": "@design-system/tokens",
  "version": "0.0.0",
  "description": "Design tokens (DTCG) and Style Dictionary pipeline. Source of truth for CSS variables, TS and JSON outputs.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/tokens.js",
  "types": "./dist/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.json": "./dist/tokens.json",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "validate": "node build/validate.ts",
    "build": "pnpm validate && node build/build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test build/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "style-dictionary": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "private": true
}

{
  "color": {
    "$type": "color",
    "background": {
      "primary": {
        "$value": "{color.white}",
        "$description": "Default page/app background"
      },
      "secondary": {
        "$value": "{color.gray.50}",
        "$description": "Subtle section background"
      },
      "tertiary": {
        "$value": "{color.gray.100}",
        "$description": "Pressed/active neutral background"
      },
      "inverse": {
        "$value": "{color.gray.900}",
        "$description": "Inverse surface (tooltips)"
      },
      "elevated": {
        "$value": "{color.white}",
        "$description": "Raised surfaces: cards, dialogs, popovers"
      },
      "disabled": {
        "$value": "{color.gray.100}",
        "$description": "Disabled control background"
      },
      "transparent": {
        "$value": "{color.transparent}",
        "$description": "Fully transparent"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.gray.900}",
        "$description": "Default text"
      },
      "secondary": {
        "$value": "{color.gray.600}",
        "$description": "Supporting text"
      },
      "inverse": {
        "$value": "{color.gray.50}",
        "$description": "Text on inverse surfaces"
      },
      "disabled": {
        "$value": "{color.gray.400}",
        "$description": "Disabled text (WCAG-exempt)"
      },
      "placeholder": {
        "$value": "{color.gray.500}",
        "$description": "Input placeholder"
      },
      "on-action": {
        "$value": "{color.white}",
        "$description": "Text on action backgrounds"
      },
      "link": {
        "$value": "{color.blue.700}",
        "$description": "Inline link"
      }
    },
    "action": {
      "primary": {
        "$root": {
          "$value": "{color.blue.600}",
          "$description": "Primary action"
        },
        "hover": {
          "$value": "{color.blue.700}",
          "$description": "Primary action hover"
        },
        "active": {
          "$value": "{color.blue.800}",
          "$description": "Primary action pressed"
        }
      },
      "secondary": {
        "$root": {
          "$value": "{color.gray.100}",
          "$description": "Secondary action"
        },
        "hover": {
          "$value": "{color.gray.200}",
          "$description": "Secondary action hover"
        },
        "active": {
          "$value": "{color.gray.300}",
          "$description": "Secondary action pressed"
        }
      },
      "danger": {
        "$root": {
          "$value": "{color.red.600}",
          "$description": "Destructive action"
        },
        "hover": {
          "$value": "{color.red.700}",
          "$description": "Destructive action hover"
        },
        "active": {
          "$value": "{color.red.800}",
          "$description": "Destructive action pressed"
        }
      }
    },
    "border": {
      "default": {
        "$value": "{color.gray.200}",
        "$description": "Decorative borders and dividers"
      },
      "strong": {
        "$value": "{color.gray.400}",
        "$description": "Emphasised borders"
      },
      "input": {
        "$value": "{color.gray.500}",
        "$description": "Form control boundary (>=3:1, WCAG 1.4.11)"
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.blue.600}",
        "$description": "Focus indicator"
      }
    },
    "feedback": {
      "success": {
        "$root": {
          "$value": "{color.green.700}",
          "$description": "success foreground (text/icon)"
        },
        "subtle": {
          "$value": "{color.green.50}",
          "$description": "success background"
        },
        "border": {
          "$value": "{color.green.300}",
          "$description": "success border"
        }
      },
      "warning": {
        "$root": {
          "$value": "{color.amber.700}",
          "$description": "warning foreground (text/icon)"
        },
        "subtle": {
          "$value": "{color.amber.50}",
          "$description": "warning background"
        },
        "border": {
          "$value": "{color.amber.300}",
          "$description": "warning border"
        }
      },
      "error": {
        "$root": {
          "$value": "{color.red.700}",
          "$description": "error foreground (text/icon)"
        },
        "subtle": {
          "$value": "{color.red.50}",
          "$description": "error background"
        },
        "border": {
          "$value": "{color.red.300}",
          "$description": "error border"
        }
      },
      "info": {
        "$root": {
          "$value": "{color.blue.700}",
          "$description": "info foreground (text/icon)"
        },
        "subtle": {
          "$value": "{color.blue.50}",
          "$description": "info background"
        },
        "border": {
          "$value": "{color.blue.300}",
          "$description": "info border"
        }
      }
    }
  }
}

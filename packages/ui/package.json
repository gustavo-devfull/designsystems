{
  "name": "@sette/ui",
  "version": "0.0.0",
  "description": "Sette Design System \u2014 accessible, themeable React components driven by design tokens.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm build:js && pnpm build:types && pnpm build:css",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json && node build/fix-dts-extensions.mjs",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css && node build/copy-tokens.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:a11y": "vitest run -t a11y",
    "test:watch": "vitest",
    "check:package": "publint --strict && attw --pack --profile esm-only --exclude-entrypoints ./styles.css ./tokens.css ./tailwind.css",
    "test:package": "node build/smoke-consumer.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-tabs": "catalog:",
    "@radix-ui/react-tooltip": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@design-system/icons": "workspace:*",
    "@design-system/tokens": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/cli": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "axe-core": "catalog:",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gustavo-devfull/designsystems.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/gustavo-devfull/designsystems#readme",
  "bugs": {
    "url": "https://github.com/gustavo-devfull/designsystems/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "tailwindcss",
    "design-tokens",
    "accessibility",
    "wcag",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  }
}
